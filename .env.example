# SpyD Home Heat — environment template
#
# Copy to .env and fill in. EVERY variable here is REQUIRED: the server throws at
# startup if any is missing or empty, and the error names the variable. There are
# no defaults by design — a silent default lets the service start and then fail
# somewhere that does not name the cause, which inside a container means a
# service that looks healthy and is broken.
#
# This file is a TEMPLATE. It contains no real credentials and is committed.
# The real .env is not committed and must never be.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on. 3008 is the production port claimed on
# DP600; 53008 is the dev slot, per the ####/5#### convention.
PORT=3008

# Vite dev server port. Development only — in production the Express server
# serves the built client from PORT, so there is no second port.
VITE_DEV_PORT=5178

# ---------------------------------------------------------------------------
# Database — PostgreSQL 17 on DP600
# ---------------------------------------------------------------------------
# These are deployment facts, not application constants. The host is a compose
# service name on the `symbiosis` network, so hard-coding any of them would mean
# the container could only ever run in one place. A default host in particular
# is how a service quietly connects to the wrong database.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=house_heating
DB_USER=house_heating

# Supplied to the container from the host's keychain-backed .env. Never commit a
# value here, and never echo it: a .env line is a secret and printing one puts it
# in a permanent transcript.
HOUSE_HEATING_PASSWORD=
